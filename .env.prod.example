# ══════════════════════════════════════════════════
#  LojalyxIT — Variables d'environnement PRODUCTION
#  Copier en .env et remplir toutes les valeurs
# ══════════════════════════════════════════════════

# === Django ===
SECRET_KEY=REMPLACER_PAR_UNE_CLE_LONGUE_ET_ALEATOIRE
DEBUG=False
ALLOWED_HOSTS=lojalyxit.com,www.lojalyxit.com

# === Base de données ===
POSTGRES_DB=lojalyxit
POSTGRES_USER=lojalyxit_user
POSTGRES_PASSWORD=MOT_DE_PASSE_FORT_POSTGRES
POSTGRES_HOST=db
POSTGRES_PORT=5432

# === CORS ===
CORS_ALLOWED_ORIGINS=https://lojalyxit.com,https://www.lojalyxit.com

# === Email SMTP (port 587 TLS) ===
# IMPORTANT : EMAIL_CONSOLE=False sinon les emails restent dans les logs Docker (jamais envoyés)
EMAIL_CONSOLE=False
EMAIL_HOST=smtp.lojalyxit.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@lojalyxit.com
EMAIL_HOST_PASSWORD=MOT_DE_PASSE_SMTP
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=LojalyxIT <noreply@lojalyxit.com>
CEO_EMAIL=ceo@lojalyxit.com
# Destinataire des notifications (devis + formulaire de contact)
DEVIS_NOTIFICATION_EMAIL=ceo@lojalyxit.com

# === Anti-spam formulaire de contact ===
# Nombre de messages autorisés par adresse IP (ex. 5/hour, 10/day)
CONTACT_THROTTLE_RATE=5/hour

# === Next.js ===
NEXT_PUBLIC_API_URL=https://lojalyxit.com
# Variables NEXT_PUBLIC_* : à mettre aussi dans frontend/.env.production (lues au build)
# Voir frontend/.env.production.example

# === Gunicorn ===
GUNICORN_WORKERS=3
