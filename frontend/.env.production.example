# Variables du frontend Next.js en PRODUCTION.
# Sur le VPS : copier ce fichier en /var/www/lojalyxit/frontend/.env.production,
# remplir les valeurs, puis relancer `npm run build` et `pm2 restart lojalyxit-frontend`.
# Les variables NEXT_PUBLIC_* sont intégrées au moment du build : un simple restart ne suffit pas.

# URL publique de l'API Django
NEXT_PUBLIC_API_URL=https://lojalyxit.com

# ID du Pixel Meta (Gestionnaire d'événements Meta > Sources de données > votre Pixel).
# Laisser vide pour désactiver le Pixel.
NEXT_PUBLIC_META_PIXEL_ID=

# Email public affiché (page Contact, footer, données structurées).
# Passer à contact@lojalyxit.com une fois la boîte créée.
NEXT_PUBLIC_CONTACT_EMAIL=ceo@lojalyxit.com
