# === Base de données ===
POSTGRES_DB=lojalyxit
POSTGRES_USER=lojalyxit
POSTGRES_PASSWORD=changeme_in_prod
POSTGRES_HOST=db
POSTGRES_PORT=5432

# === Django ===
SECRET_KEY=change_me_with_python_-c_"from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# === CORS ===
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─────────────────────────────────────────────────────
# === Email ===
#
# Pour tester en LOCAL sans vrai serveur mail :
#   EMAIL_CONSOLE=True   → les emails s'affichent dans les logs Docker
#                          (aucun email réel n'est envoyé)
#
# Pour la PRODUCTION (envoi réel via Zoho SMTP) :
#   EMAIL_CONSOLE=False  → utilise les identifiants SMTP ci-dessous
# ─────────────────────────────────────────────────────
EMAIL_CONSOLE=True

# Paramètres SMTP Zoho (actifs uniquement si EMAIL_CONSOLE=False)
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=ceo@lojalyxit.com
# Mot de passe d'application Zoho : à renseigner uniquement dans .env / .env.prod (jamais ici)
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ceo@lojalyxit.com

# Destinataire des notifications de devis
DEVIS_NOTIFICATION_EMAIL=ceo@lojalyxit.com

# Anti-spam du formulaire de contact (messages par IP)
CONTACT_THROTTLE_RATE=5/hour

# === Next.js ===
NEXT_PUBLIC_API_URL=http://localhost:8000
# ID du Pixel Meta (laisser vide = Pixel désactivé)
NEXT_PUBLIC_META_PIXEL_ID=
# Email public affiché sur le site (passer à contact@lojalyxit.com quand la boîte existera)
NEXT_PUBLIC_CONTACT_EMAIL=ceo@lojalyxit.com
